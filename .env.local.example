# ── Upstash Redis（免費）────────────────────────────────────────
# 到 https://console.upstash.com 建立 Redis 資料庫後取得
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Gmail 寄件設定 ──────────────────────────────────────────────
# 寄件者 Gmail 帳號
EMAIL_SENDER=your_email@gmail.com
# Gmail 應用程式密碼（非登入密碼）
# 取得方式：Google 帳戶 → 安全性 → 兩步驟驗證 → 應用程式密碼
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# 接收通知的 Email（可以和寄件者相同）
EMAIL_RECIPIENT=your_email@gmail.com

# ── 安全金鑰 ───────────────────────────────────────────────────
# 自訂一串隨機字串，cron-job.org 呼叫時會帶上此金鑰
CRON_SECRET=my-secret-key-change-this-123
